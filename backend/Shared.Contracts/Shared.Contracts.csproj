<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    ApiResponseFilter và ExceptionMiddleware dùng Microsoft.AspNetCore.Mvc.Filters
    nên project cần framework reference tới ASP.NET Core.
    Đây là framework reference (không phải PackageReference) nên không kéo theo
    DLL nào vào output của service - chỉ cung cấp API compile-time.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>