{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {

      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "profile-userprofile-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/userprofile/{**catch-all}"
        }
      },

      "profile-phongban-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/phongban/{**catch-all}"
        }
      },

      "profile-chucvu-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/chucvu/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://localhost:5005/"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-destination": {
            "Address": "http://localhost:5006/"
          }
        }
      }
    }
  }
}
